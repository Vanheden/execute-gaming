# Copy this file to ".env" and fill in your values, then restart the server.

# --- Server ---
PORT=3001
# Long random string used to sign session cookies. Change this!
SESSION_SECRET=change-me-to-a-long-random-string
# The URL the browser uses (frontend). Keep as-is for local dev.
PUBLIC_BASE_URL=http://localhost:5173

# Admins by Discord user id (comma-separated). This is the lockout-proof way to
# grant admin — it doesn't depend on Discord role sync. Enable Developer Mode in
# Discord, right-click a user → Copy User ID.
#   DISCORD_ADMIN_USER_IDS=213993034075996162,987654321098765432
# NOTE: admin is now ENTIRELY env-driven and recomputed on every login — there's
# no "first login becomes admin" and no in-app promote button. A member is an
# admin if their id is listed here OR they hold a role in DISCORD_ADMIN_ROLE_IDS.
DISCORD_ADMIN_USER_IDS=

# --- Discord OAuth2 ---
# Create an app at https://discord.com/developers/applications
# In OAuth2 → Redirects, add: http://localhost:5173/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Discord role sync (optional) ---
# Your community server (guild) ID. Enable Developer Mode in Discord, then
# right-click your server → Copy Server ID.
# Also powers the live "who's online" widget on the site — for that, enable
# Server Settings → Widget → "Enable Server Widget" in Discord (no bot needed).
DISCORD_GUILD_ID=
# Role IDs (comma-separated) that should make a member a site admin. Right-click
# a role in Server Settings → Roles → Copy Role ID.
DISCORD_ADMIN_ROLE_IDS=
# Optional bot token — only needed to show role NAMES/COLORS (not just admin
# mapping). Create a bot under your app → Bot, and invite it to the server.
DISCORD_BOT_TOKEN=

# --- Discord announcements webhook (optional) ---
# Posts news, events, the announcement banner, player rank-ups, suggestion updates,
# season resets and community milestones to a Discord channel as rich embeds. Create
# one under the target channel → Edit Channel → Integrations → Webhooks → New Webhook
# → Copy Webhook URL. No bot needed. Admins can mute individual categories and send a
# test post from /admin → Settings. Leave blank to disable — nothing is ever posted
# and requests are unaffected.
DISCORD_WEBHOOK_URL=

# --- Steam ---
# Get a Web API key at https://steamcommunity.com/dev/apikey
# Use "localhost" as the domain when registering the key.
STEAM_API_KEY=

# --- Cloudflare Turnstile (CAPTCHA, optional) ---
# Protects login and suggestion posting from bots. Create a widget at
# https://dash.cloudflare.com → Turnstile. Add your domain(s) as allowed hostnames
# (include "localhost" for local testing). Both keys must be set to enable the
# CAPTCHA — leave either blank and it's skipped entirely (login/suggestions work
# unguarded). The SITE key is public (served to the browser); the SECRET key must
# stay server-side. For local testing you can use Cloudflare's always-pass test
# keys: SITE 1x00000000000000000000AA / SECRET 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Playtime leaderboard ingest ---
# Shared secret the in-game BepInEx mod sends (header: X-Ingest-Secret) when
# POSTing play sessions to /api/ingest/session. Use a long random string and put
# the SAME value in the mod's config. Leave blank to disable ingest entirely
# (the endpoint then returns 503, so the leaderboard just stays empty).
INGEST_SECRET=

# --- BattleMetrics (live player counts / server status, optional) ---
# The site reads live player counts + online/offline status from BattleMetrics.
# Anonymous requests are increasingly Cloudflare-challenged (they return an HTML
# block page instead of JSON, so the site shows "Unknown"/0 players). Create a
# free API token at https://www.battlemetrics.com/account → "API Access" and put
# it here to use the authenticated API path. Leave blank to keep anonymous access.
BATTLEMETRICS_TOKEN=
